@model List<JadooTravel.ViewModels.BookingViewModel>

@{
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="row">
  <div class="col-lg-12 d-flex align-items-stretch">
    <div class="card w-100 shadow-sm">
      <div class="card-body p-4">
        
        
        <div class="mb-4">
          <h5 class="mb-1 fw-bold d-flex align-items-center gap-2">
            <iconify-icon icon="solar:ticket-bold-duotone" class="fs-7 text-primary"></iconify-icon>
            Rezervasyon Talepleri
          </h5>
          <p class="text-muted mb-0 fs-2">Web sitenizden müşterilerin gönderdiği tüm aktif tur rezervasyon isteklerini buradan yönetebilirsiniz.</p>
        </div>

        
        <div class="table-responsive" data-simplebar>
          <table class="table table-hover align-middle text-nowrap mb-0">
            <thead class="text-dark fs-3 bg-light">
              <tr>
                <th scope="col" class="border-bottom-0">Müşteri Bilgileri</th>
                <th scope="col" class="border-bottom-0">Seçilen Tur / Rota</th>
                <th scope="col" class="border-bottom-0">Gidiş Tarihi</th>
                <th scope="col" class="border-bottom-0">Kişi Sayısı</th>
                <th scope="col" class="border-bottom-0">Toplam Tutar</th>
                <th scope="col" class="border-bottom-0 text-end" style="width: 15%">İşlem</th>
              </tr>
            </thead>
            <tbody>
              @if (Model != null && Model.Any())
              {
                  foreach (var item in Model)
                  {
                      <tr>
                        
                        <td>
                          <div>
                            <span class="fw-semibold text-dark fs-3 d-block">@item.Booking.FullName</span>
                            <span class="text-muted fs-2 d-block"><i class="ti ti-phone me-1"></i> @item.Booking.Phone</span>
                            <span class="text-muted fs-2"><i class="ti ti-mail me-1"></i> @item.Booking.Email</span>
                          </div>
                        </td>
                        
                        
                        <td>
                          @if (item.Destination != null)
                          {
                              <div class="d-flex align-items-center gap-3">
                                <img src="@item.Destination.ImageUrl" class="rounded-2 object-fit-cover border" style="width: 50px; height: 35px;" />
                                <div>
                                  <span class="fw-semibold text-dark fs-3 d-block">@item.Destination.City</span>
                                  <span class="text-muted fs-2">@item.Destination.Country</span>
                                </div>
                              </div>
                          }
                          else
                          {
                              <span class="text-danger fs-2 fw-semibold">Silinmiş Rota (ID: @item.Booking.DestinationId)</span>
                          }
                        </td>

                        
                        <td>
                          <span class="text-dark fw-normal fs-3">
                            <i class="ti ti-calendar me-1 text-muted"></i> @item.Booking.TravelDate?.ToString("dd MMMM yyyy")
                          </span>
                        </td>

                        
                        <td>
                          <span class="badge bg-light-secondary text-secondary px-3 py-1 fs-2 fw-semibold">
                            @item.Booking.GuestsCount Kişi
                          </span>
                        </td>

                        
                        <td>
                          @if (item.Destination != null)
                          {
                              var total = item.Destination.Price * item.Booking.GuestsCount;
                              <span class="fw-bold text-success fs-3">@total.ToString("F2") $</span>
                          }
                          else
                          {
                              <span class="text-muted">-</span>
                          }
                        </td>
                        
                        
                        <td class="text-end">
                          <a asp-controller="Booking" asp-action="DeleteBooking" asp-route-id="@item.Booking.BookingId"
                             class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 justify-content-center"
                             onclick="return confirm('@item.Booking.FullName adına açılan talebi silmek istediğinize emin misiniz?')">
                            <i class="ti ti-trash fs-4"></i> Talebi Sil
                          </a>
                        </td>
                      </tr>
                  }
              }
              else
              {
                  <tr>
                    <td colspan="6" class="text-center py-5 text-muted fs-3">
                      <iconify-icon icon="solar:ticket-sale-bold-duotone" class="fs-9 text-muted mb-2 d-block"></iconify-icon>
                      Henüz hiçbir rezervasyon talebi alınmadı.
                    </td>
                  </tr>
              }
            </tbody>
          </table>
        </div>
        

      </div>
    </div>
  </div>
</div>