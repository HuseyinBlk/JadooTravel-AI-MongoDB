@model List<JadooTravel.Dtos.SubscribeDtos.ResultSubscribeDto>

@{
    ViewData["Title"] = "Bülten Aboneleri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        
        
        <div class="mb-9">
          <h4 class="card-title">Bülten Aboneleri</h4>
          <p class="card-subtitle mb-0">Web sitenizin bültenine kaydolmuş kullanıcıların e-posta listesini buradan inceleyebilir ve yönetebilirsiniz.</p>
        </div>

        
        <div class="table-responsive">
          <table class="table align-middle text-nowrap mb-0">
            <thead class="text-dark fs-3">
              <tr>
                <th class="border-bottom-0" style="width: 80px;"><h6 class="fw-semibold mb-0">#</h6></th>
                <th class="border-bottom-0"><h6 class="fw-semibold mb-0">E-posta Adresi</h6></th>
                <th class="border-bottom-0 text-end" style="width: 150px;"><h6 class="fw-semibold mb-0">İşlemler</h6></th>
              </tr>
            </thead>
            <tbody>
              @if (Model != null && Model.Any())
              {
                  foreach (var item in Model)
                  {
                      count++;
                      <tr>
                        
                        <td class="border-bottom-0">
                          <h6 class="fw-semibold mb-0">@count</h6>
                        </td>
                        
                        
                        <td class="border-bottom-0">
                          <div class="d-flex align-items-center gap-2">
                            <i class="ti ti-mail fs-5 text-muted"></i>
                            <span class="text-dark fw-semibold fs-3">@item.Email</span>
                          </div>
                        </td>

                        
                        <td class="border-bottom-0 text-end">
                          <button type="button" class="btn btn-sm btn-light-danger text-danger d-flex align-items-center gap-1 px-3 py-2 ms-auto" 
                                  data-bs-toggle="modal" data-bs-target="#deleteModal-@item.SubscribeId">
                            <i class="ti ti-trash fs-4"></i> Sil
                          </button>
                        </td>
                      </tr>

                      
                      <div class="modal fade" id="deleteModal-@item.SubscribeId" tabindex="-1" aria-labelledby="deleteModalLabel-@item.SubscribeId" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                            <div class="modal-header border-bottom-0 pb-0">
                              <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel-@item.SubscribeId">Aboneliği Sil</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body py-3 text-start">
                              <p class="mb-0"><strong>@item.Email</strong> adresine ait bülten aboneliği kaydını kalıcı olarak silmek istediğinize emin misiniz?</p>
                            </div>
                            <div class="modal-footer border-top-0 pt-0">
                              <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                              <a href="/Admin/Subscribe/Delete/@item.SubscribeId" class="btn btn-danger">Evet, Sil</a>
                            </div>
                          </div>
                        </div>
                      </div>
                  }
              }
              else
              {
                  <tr>
                    <td colspan="3" class="text-center py-5 border-bottom-0">
                      <div class="text-muted">
                        <i class="ti ti-info-circle fs-8 mb-2 d-block text-warning"></i>
                        Henüz hiç bülten abonesi bulunmuyor.
                      </div>
                    </td>
                  </tr>
              }
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
</div>