@model JadooTravel.Dtos.PartnerDtos.CreatePartnerDto

@{
    ViewData["Title"] = "Yeni Marka Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="row">
  
  <div class="col-lg-7 mb-4">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <h4 class="card-title mb-4">Yeni Sponsor Marka Kaydet</h4>
        
        <form action="/Admin/Partner/Create" method="post">
          
          
          <div class="mb-4">
            <label class="form-label fw-semibold text-dark" for="PhotoUrl">Logo Görsel Adresi (URL)</label>
            <input type="text" class="form-control" id="PhotoUrl" name="PhotoUrl" 
                   placeholder="https://images.unsplash.com/... veya /public/assets/img/partner/1.png" required />
            <div class="form-text">Hem internet üzerindeki resim linklerini hem de projenin içindeki lokal resim yollarını girebilirsiniz.</div>
          </div>

          
          <div class="d-flex align-items-center gap-3">
            <button type="submit" class="btn btn-primary px-4 py-2">Kaydet</button>
            <a href="/Admin/Partner" class="btn btn-light px-4 py-2">İptal</a>
          </div>

        </form>
      </div>
    </div>
  </div>

  
  <div class="col-lg-5">
    <div class="card shadow-sm border-0 bg-light-primary text-primary mb-4">
      <div class="card-body text-center py-3">
        <h6 class="mb-0 fw-semibold fs-3 text-primary">
          <i class="ti ti-eye me-1 fs-5"></i> Canlı Önizleme Paneli
        </h6>
      </div>
    </div>

    
    <div class="card shadow-hover border border-2 border-dashed rounded-3 p-4 bg-light d-flex align-items-center justify-content-center" 
         style="height: 160px;">
      <div id="previewContainer" class="d-flex align-items-center justify-content-center bg-white border rounded-3 p-3 shadow-sm" 
           style="width: 200px; height: 100px; transition: all 0.3s ease;">
        <img id="previewImage" src="/Spike-Admin/src/assets/images/logos/logo-icon.svg" 
             alt="Logo Önizleme" 
             style="max-width: 100%; max-height: 100%; object-fit: contain; filter: grayscale(100%); opacity: 0.7;" />
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    const photoInput = document.getElementById('PhotoUrl');
    const previewImage = document.getElementById('previewImage');
    const defaultLogo = '/Spike-Admin/src/assets/images/logos/logo-icon.svg';

    photoInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        if (val !== "") {
            previewImage.src = val;
            previewImage.style.filter = "none";
            previewImage.style.opacity = "1";
        } else {
            previewImage.src = defaultLogo;
            previewImage.style.filter = "grayscale(100%)";
            previewImage.style.opacity = "0.7";
        }
    });
  </script>
}