@{
    Layout = "/Views/AdminLayout/Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <iconify-icon icon="solar:magic-stick-bold-duotone" class="text-primary fs-8 me-2"></iconify-icon>
                    <h4 class="card-title mb-0 fw-bold">AI Rota Önerileri (Gezi Rehberi)</h4>
                </div>
                <p class="text-muted">Girdiğiniz şehir ve ülke bilgisine göre Gemini yapay zeka motoru, orada mutlaka görülmesi gereken en popüler 10 yeri ve tanıtımlarını sizin için listeler.</p>

                
                <div class="row mt-4">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Gemini API Key (Kişisel)</label>
                        <div class="input-group">
                            <input type="password" id="apiKeyInput" class="form-control" placeholder="AI Studio'dan aldığınız API anahtarını girin...">
                            <button class="btn btn-outline-secondary" type="button" id="toggleApiKeyBtn">
                                <i class="ti ti-eye"></i>
                            </button>
                        </div>
                        <small class="text-muted fs-2">Anahtarınız tarayıcınızın güvenli yerel hafızasında (localStorage) saklanır, üçüncü şahıslarla paylaşılmaz.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Şehir, Ülke</label>
                        <input type="text" id="destinationInput" class="form-control" placeholder="Örn: Roma, İtalya veya Tokyo, Japonya">
                    </div>
                </div>

                <button type="button" id="getRecommendationsBtn" class="btn btn-primary mt-2">
          <span class="d-flex align-items-center">
            <iconify-icon icon="solar:sparkles-bold" class="me-2"></iconify-icon>
            Önerileri Getir
          </span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row d-none" id="loadingSection">
    <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
        <h5 class="mt-3 fw-bold">Yapay zeka rotayı çiziyor...</h5>
        <p class="text-muted">En popüler gezi noktaları ve açıklamaları derleniyor, lütfen bekleyin.</p>
    </div>
</div>

<div class="row d-none" id="errorSection">
    <div class="col-12">
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <iconify-icon icon="solar:danger-circle-bold" class="fs-6 me-2"></iconify-icon>
            <div id="errorMessage">Bir hata oluştu.</div>
        </div>
    </div>
</div>

<div class="row d-none" id="resultSection">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <iconify-icon icon="solar:map-point-wave-bold-duotone" class="text-success fs-6 me-2"></iconify-icon>
                    Gezilmesi Gereken En Popüler 10 Yer (<span id="resultTitle">Roma</span>)
                </h5>

                <div class="list-group" id="placesList">
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const STORAGE_KEY = "user_gemini_api_key";

            const savedApiKey = localStorage.getItem(STORAGE_KEY);
            if (savedApiKey) {
                $("#apiKeyInput").val(savedApiKey);
            }

            $("#toggleApiKeyBtn").click(function () {
                const input = $("#apiKeyInput");
                const icon = $(this).find("i");
                if (input.attr("type") === "password") {
                    input.attr("type", "text");
                    icon.removeClass("ti-eye").addClass("ti-eye-off");
                } else {
                    input.attr("type", "password");
                    icon.removeClass("ti-eye-off").addClass("ti-eye");
                }
            });

            $("#getRecommendationsBtn").click(function () {
                const apiKey = $("#apiKeyInput").val().trim();
                const destination = $("#destinationInput").val().trim();

                if (!destination) {
                    alert("Lütfen bir şehir ve ülke adı girin.");
                    return;
                }

                if (apiKey) {
                    localStorage.setItem(STORAGE_KEY, apiKey);
                } else {
                    localStorage.removeItem(STORAGE_KEY);
                }

                $("#loadingSection").removeClass("d-none");
                $("#resultSection").addClass("d-none");
                $("#errorSection").addClass("d-none");
                $("#getRecommendationsBtn").prop("disabled", true);

                $.ajax({
                    url: "/Admin/AiRecommend/GetPlaces",
                    type: "POST",
                    data: {
                        destination: destination,
                        customApiKey: apiKey
                    },
                    success: function (response) {
                        $("#loadingSection").addClass("d-none");
                        $("#getRecommendationsBtn").prop("disabled", false);

                        if (response.success) {
                            $("#placesList").empty();
                            $("#resultTitle").text(destination);

                            response.places.forEach((place, index) => {
                                const itemHtml = `
                            <div class="list-group-item list-group-item-action d-flex align-items-start py-3 border-bottom border-light">
                                <span class="badge bg-light-primary text-primary rounded-circle p-2 me-3 fs-3 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; min-width: 35px;">
                                    ${index + 1}
                                </span>
                                <div>
                                    <div class="fw-bold text-dark fs-4 mb-1">${place.name}</div>
                                    <p class="text-muted mb-0 fs-3">${place.description}</p>
                                </div>
                            </div>
                        `;
                                $("#placesList").append(itemHtml);
                            });

                            $("#resultSection").removeClass("d-none");
                        } else {
                            $("#errorMessage").text(response.message);
                            $("#errorSection").removeClass("d-none");
                        }
                    },
                    error: function () {
                        $("#loadingSection").addClass("d-none");
                        $("#getRecommendationsBtn").prop("disabled", false);
                        $("#errorMessage").text("Sunucu ile iletişim kurulurken bilinmeyen bir hata oluştu.");
                        $("#errorSection").removeClass("d-none");
                    }
                });
            });
        });
    </script>
}