@model CreateDestinationDto

@{
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        
        <h5 class="card-title fw-bold mb-4 d-flex align-items-center gap-2">
          <iconify-icon icon="solar:map-point-add-bold-duotone" class="fs-7 text-primary"></iconify-icon>
          Yeni Tur Rotası Tanımla
        </h5>
        <p class="text-muted mb-4 fs-2">Aşağıdaki alanları eksiksiz doldurarak ana sayfada listelenecek yeni bir tur paketi ekleyin.</p>

        <form asp-controller="Destination" asp-action="CreateDestination" method="post">
          <div class="row">
            
            
            <div class="col-md-6 mb-3">
              <label for="City" class="form-label fw-semibold">Şehir</label>
              <input type="text" class="form-control" asp-for="City" placeholder="Örn: Roma" required />
              <span class="text-danger fs-2" asp-validation-for="City"></span>
            </div>

            <div class="col-md-6 mb-3">
              <label for="Country" class="form-label fw-semibold">Ülke</label>
              <input type="text" class="form-control" asp-for="Country" placeholder="Örn: İtalya" required />
              <span class="text-danger fs-2" asp-validation-for="Country"></span>
            </div>

            
            <div class="col-md-4 mb-3">
              <label for="Price" class="form-label fw-semibold">Tur Fiyatı ($)</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">$</span>
                <input type="number" step="0.01" class="form-control border-start-0" asp-for="Price" placeholder="0.00" required />
              </div>
              <span class="text-danger fs-2" asp-validation-for="Price"></span>
            </div>

            <div class="col-md-4 mb-3">
              <label for="DayNight" class="form-label fw-semibold">Tur Süresi</label>
              <input type="text" class="form-control" asp-for="DayNight" placeholder="Örn: 3 Gün 4 Gece" required />
              <span class="text-danger fs-2" asp-validation-for="DayNight"></span>
            </div>

            <div class="col-md-4 mb-3">
              <label for="Capacity" class="form-label fw-semibold">Tur Kontenjanı (Kişi)</label>
              <input type="number" class="form-control" asp-for="Capacity" placeholder="Örn: 20" required />
              <span class="text-danger fs-2" asp-validation-for="Capacity"></span>
            </div>

            
            <div class="col-12 mb-3">
              <label for="ImageUrl" class="form-label fw-semibold">Görsel Adresi (URL)</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                  <i class="ti ti-photo"></i>
                </span>
                <input type="text" class="form-control border-start-0" asp-for="ImageUrl" placeholder="https://resimlinki.com/resim.jpg" required />
              </div>
              <span class="text-danger fs-2" asp-validation-for="ImageUrl"></span>
            </div>

            
            <div class="col-12 mb-4">
              <label for="Description" class="form-label fw-semibold">Tur Detayları & Açıklama</label>
              <textarea class="form-control" asp-for="Description" rows="5" placeholder="Tur rotası, gezilecek yerler ve dahil olan hizmetler hakkında detaylı açıklama girin..." required></textarea>
              <span class="text-danger fs-2" asp-validation-for="Description"></span>
            </div>

            
            <div class="col-12 d-flex justify-content-end gap-2">
              <a asp-controller="Destination" asp-action="Index" class="btn btn-outline-secondary">İptal Et</a>
              <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="ti ti-device-floppy fs-5"></i>
                Turu Kaydet ve Yayınla
              </button>
            </div>
            
          </div>
        </form>

      </div>
    </div>
  </div>
</div>