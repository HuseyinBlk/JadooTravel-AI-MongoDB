@model List<ResultDestinationDto>

@{
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>

<div class="container">
    <br/><br/>
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Tur Şehir Ülke</th>
            <th>Tur Fiyatı<th>
            <th>Tur Kapasitesi</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DestinationId</td>
                <td>@item.City @item.Country</td>
                <td>@item.City @item.Price</td>
                <td>@item.City @item.Capacity</td>
                <td><a href="/Destination/DeleteDestination/@item.DestinationId" class="btn btn-danger">Sil</a></td>
                <td><a href="/Destination/UpdateDestination/@item.DestinationId" class="btn btn-success">Güncelle</a></td>
            </tr>
        }
    </table>
    <a href="/Category/CreateCategory/" class="btn btn-info">Yeni Kategori Girişi</a>
</div>