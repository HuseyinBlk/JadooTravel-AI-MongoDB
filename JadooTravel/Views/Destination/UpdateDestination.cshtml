@model GetDestinationByIdDto

@{
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="row">
  
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        
        <h5 class="card-title fw-bold mb-4 d-flex align-items-center gap-2">
          <iconify-icon icon="solar:pen-new-square-bold-duotone" class="fs-7 text-warning"></iconify-icon>
          Tur Rotası Güncelle
        </h5>
        <p class="text-muted mb-4 fs-2">Seçili rotanın seyahat ve fiyat bilgilerini buradan revize edebilirsiniz.</p>

        <form asp-controller="Destination" asp-action="UpdateDestination" method="post">
          
          <input type="hidden" asp-for="DestinationId" />

          <div class="row">
            
            
            <div class="col-md-6 mb-3">
              <label for="City" class="form-label fw-semibold">Şehir</label>
              <input type="text" class="form-control" asp-for="City" required />
              <span class="text-danger fs-2" asp-validation-for="City"></span>
            </div>

            <div class="col-md-6 mb-3">
              <label for="Country" class="form-label fw-semibold">Ülke</label>
              <input type="text" class="form-control" asp-for="Country" required />
              <span class="text-danger fs-2" asp-validation-for="Country"></span>
            </div>

            
            <div class="col-md-4 mb-3">
              <label for="Price" class="form-label fw-semibold">Tur Fiyatı ($)</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">$</span>
                <input type="number" step="0.01" class="form-control border-start-0" asp-for="Price" required />
              </div>
              <span class="text-danger fs-2" asp-validation-for="Price"></span>
            </div>

            <div class="col-md-4 mb-3">
              <label for="DayNight" class="form-label fw-semibold">Tur Süresi</label>
              <input type="text" class="form-control" asp-for="DayNight" required />
              <span class="text-danger fs-2" asp-validation-for="DayNight"></span>
            </div>

            <div class="col-md-4 mb-3">
              <label for="Capacity" class="form-label fw-semibold">Tur Kontenjanı (Kişi)</label>
              <input type="number" class="form-control" asp-for="Capacity" required />
              <span class="text-danger fs-2" asp-validation-for="Capacity"></span>
            </div>

            
            <div class="col-12 mb-3">
              <label for="ImageUrl" class="form-label fw-semibold">Görsel Adresi (URL)</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                  <i class="ti ti-photo"></i>
                </span>
                <input type="text" class="form-control border-start-0" asp-for="ImageUrl" id="ImageUrlInput" required />
              </div>
              <span class="text-danger fs-2" asp-validation-for="ImageUrl"></span>
            </div>

            
            <div class="col-12 mb-4">
              <label for="Description" class="form-label fw-semibold">Tur Detayları & Açıklama</label>
              <textarea class="form-control" asp-for="Description" rows="5" required></textarea>
              <span class="text-danger fs-2" asp-validation-for="Description"></span>
            </div>

            
            <div class="col-12 d-flex justify-content-end gap-2">
              <a asp-controller="Destination" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
              <button type="submit" class="btn btn-warning text-white d-flex align-items-center gap-2">
                <i class="ti ti-refresh fs-5"></i>
                Değişiklikleri Güncelle
              </button>
            </div>
            
          </div>
        </form>

      </div>
    </div>
  </div>

  
  <div class="col-lg-4">
    <div class="card shadow-sm h-100 border overflow-hidden">
      
      <div class="position-relative" style="height: 220px; background-color: #f6f9fc;">
        @if (!string.IsNullOrEmpty(Model?.ImageUrl))
        {
            <img src="@Model.ImageUrl" id="preview-image" alt="Tur Görseli" class="w-100 h-100 object-fit-cover" />
        }
        else
        {
            <img src="" id="preview-image" alt="Tur Görseli" class="w-100 h-100 object-fit-cover d-none" />
            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted" id="preview-image-placeholder">
              <i class="ti ti-photo fs-9 mb-2"></i>
              <span class="fs-2">Görsel URL girildiğinde yüklenecek</span>
            </div>
        }
      </div>
      
      <div class="card-body p-4">
        <span class="badge bg-light-primary text-primary px-3 py-1 fs-2 fw-semibold mb-2" id="preview-duration">
          <i class="ti ti-clock me-1"></i> @Model?.DayNight
        </span>
        <h4 class="fw-bolder text-dark mb-2" id="preview-destination-title">
          @Model?.City, @Model?.Country
        </h4>
        <p class="text-muted fs-2 lh-base text-truncate-2" id="preview-desc-text">
          @Model?.Description
        </p>
        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-3">
          <span class="fs-4 text-primary fw-bold" id="preview-price">
            @Model?.Price.ToString("F2") $
          </span>
          <span class="fs-2 text-muted" id="preview-capacity">
            <i class="ti ti-users me-1"></i> @Model?.Capacity Kişi Kapasite
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    $(document).ready(function() {
      $('#ImageUrlInput').on('input', function() {
        var url = $(this).val();
        if(url) {
          $('#preview-image').attr('src', url).removeClass('d-none');
          $('#preview-image-placeholder').addClass('d-none');
        } else {
          $('#preview-image').addClass('d-none');
          $('#preview-image-placeholder').removeClass('d-none');
        }
      });
      
      $('#City, #Country').on('input', function() {
        var city = $('#City').val();
        var country = $('#Country').val();
        $('#preview-destination-title').text(city + ", " + country);
      });

      $('#DayNight').on('input', function() {
        var duration = $(this).val();
        $('#preview-duration').html('<i class="ti ti-clock me-1"></i> ' + duration);
      });

      $('#Description').on('input', function() {
        var desc = $(this).val();
        $('#preview-desc-text').text(desc);
      });

      $('#Price').on('input', function() {
        var price = $(this).val();
        $('#preview-price').text(parseFloat(price || 0).toFixed(2) + " $");
      });

      $('#Capacity').on('input', function() {
        var capacity = $(this).val();
        $('#preview-capacity').html('<i class="ti ti-users me-1"></i> ' + capacity + ' Kişi Kapasite');
      });
    });
  </script>
}