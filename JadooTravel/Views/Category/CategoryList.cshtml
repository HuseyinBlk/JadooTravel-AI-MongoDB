@model List<ResultCategoryDto>

@{
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="row">
  <div class="col-lg-12 d-flex align-items-stretch">
    <div class="card w-100 shadow-sm">
      <div class="card-body p-4">
        
        
        <div class="d-flex mb-4 justify-content-between align-items-center">
          <div>
            <h5 class="mb-1 fw-bold d-flex align-items-center gap-2">
              <iconify-icon icon="solar:layers-bold-duotone" class="fs-7 text-primary"></iconify-icon>
              Kategori Yönetimi (@(Model?.Count ?? 0) / 4)
            </h5>
            <p class="text-muted mb-0 fs-2">Web sitenizin ana sayfasındaki hizmetler bölümünde en fazla 4 adet kategori gösterebilirsiniz.</p>
          </div>

          
          @if (Model == null || Model.Count < 4)
          {
              <a asp-controller="Category" asp-action="CreateCategory" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="ti ti-plus fs-5"></i>
                Yeni Kategori Girişi
              </a>
          }
        </div>

        
        @if (Model != null && Model.Count >= 4)
        {
            <div class="alert alert-warning border-0 d-flex align-items-center gap-3 mb-4 rounded-3" role="alert">
              <iconify-icon icon="solar:info-circle-bold-duotone" class="fs-6 text-warning"></iconify-icon>
              <div>
                <strong>Maksimum Kategori Sınırı:</strong> Ana sayfada en fazla 4 kategori sergilenebilir. Yeni bir kategori eklemek için mevcut kategorilerden birini silmeniz gerekmektedir.
              </div>
            </div>
        }

        
        <div class="table-responsive" data-simplebar>
          <table class="table table-hover align-middle text-nowrap mb-0">
            <thead class="text-dark fs-3 bg-light">
              <tr>
                <th scope="col" class="border-bottom-0" style="width: 10%">İkon</th>
                <th scope="col" class="border-bottom-0">Kategori Adı</th>
                <th scope="col" class="border-bottom-0">Açıklama</th>
                <th scope="col" class="border-bottom-0" style="width: 12%">Durum</th>
                <th scope="col" class="border-bottom-0 text-end" style="width: 20%">İşlemler</th>
              </tr>
            </thead>
            <tbody>
              @if (Model != null && Model.Any())
              {
                  foreach (var item in Model)
                  {
                      <tr>
                        
                        <td>
                          <div class="bg-light-primary text-primary rounded-3 d-flex align-items-center justify-content-center p-2" style="width: 45px; height: 45px;">
                            @if (!string.IsNullOrEmpty(item.IconUrl) && item.IconUrl.StartsWith("http"))
                            {
                                <img src="@item.IconUrl" alt="" width="24" height="24" class="object-fit-contain" />
                            }
                            else
                            {
                                <i class="@(string.IsNullOrEmpty(item.IconUrl) ? "ti ti-category" : item.IconUrl) fs-6"></i>
                            }
                          </div>
                        </td>
                        
                        
                        <td>
                          <span class="fw-semibold text-dark fs-3">@item.CategoryName</span>
                        </td>

                        
                        <td>
                          <p class="mb-0 fw-normal text-muted text-truncate" style="max-width: 300px;">
                            @item.CategoryDescription
                          </p>
                        </td>

                        
                        <td>
                          @if (item.Status)
                          {
                              <span class="badge bg-light-success text-success rounded-pill px-3 py-1 fs-2 fw-semibold">Aktif</span>
                          }
                          else
                          {
                              <span class="badge bg-light-danger text-danger rounded-pill px-3 py-1 fs-2 fw-semibold">Pasif</span>
                          }
                        </td>
                        
                        
                        <td class="text-end">
                          <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Category" 
                               asp-action="UpdateCategory" 
                               asp-route-id="@item.CategoryId" 
                               class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1">
                              <i class="ti ti-edit fs-4"></i> Düzenle
                            </a>
                            <a asp-controller="Category" 
                               asp-action="DeleteCategory" 
                               asp-route-id="@item.CategoryId" 
                               class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                               onclick="return confirm('@item.CategoryName kategorisini silmek istediğinize emin misiniz?')">
                              <i class="ti ti-trash fs-4"></i> Sil
                            </a>
                          </div>
                        </td>
                      </tr>
                  }
              }
              else
              {
                  <tr>
                    <td colspan="5" class="text-center py-5 text-muted fs-3">
                      <iconify-icon icon="solar:folder-error-bold-duotone" class="fs-9 text-muted mb-2 d-block"></iconify-icon>
                      Kayıtlı kategori bulunamadı. Yeni bir kategori ekleyerek başlayın.
                    </td>
                  </tr>
              }
            </tbody>
          </table>
        </div>
        

      </div>
    </div>
  </div>
</div>