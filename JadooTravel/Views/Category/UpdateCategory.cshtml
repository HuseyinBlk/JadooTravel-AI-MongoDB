@model GetCategoryByIdDto

@{
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>

<div class="container">
    <br/><br/>
    <form method="post">
        <input type="hidden" asp-for="CategoryId" />
        <input type="text" class="form-control" asp-for="CategoryName" placeholder="Kategori Adını Giriniz"/>
        <br/>
        <textarea type="text" class="form-control" asp-for="CategoryDescription" placeholder="Açıklama Giriniz"  rows="3"></textarea>
        <br/>
        <button type="submit" class="btn btn-primary">Kategoriyi Güncelle</button>
    </form>
</div>
