@model JadooTravel.Entities.AppUser

<header class="app-header">
  <nav class="navbar navbar-expand-lg navbar-light">
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link sidebartoggler " id="headerCollapse" href="javascript:void(0)">
          <i class="ti ti-menu-2"></i>
        </a>
      </li>
      
      
      <li class="nav-item dropdown">
        <a class="nav-link" href="javascript:void(0)" id="drop1" data-bs-toggle="dropdown" aria-expanded="false">
          <iconify-icon icon="solar:bell-linear" class="fs-6"></iconify-icon>
          @if (ViewBag.NotificationCount > 0)
          {
              <div class="notification bg-primary rounded-circle"></div>
          }
        </a>
        <div class="dropdown-menu dropdown-menu-animate-up" aria-labelledby="drop1" style="min-width: 320px;">
          <div class="px-3 py-2 border-bottom">
            <h6 class="mb-0 fw-bold">Yeni Rezervasyon Talepleri</h6>
          </div>
          <div class="message-body" style="max-height: 300px; overflow-y: auto;">
            @if (ViewBag.LatestNotifications != null && ViewBag.NotificationCount > 0)
            {
                foreach (var notif in ViewBag.LatestNotifications)
                {
                    <a href="/Admin/Booking" class="dropdown-item d-flex align-items-start py-3 border-bottom border-light">
                      <div class="me-3">
                        <span class="round-40 text-white bg-light-primary text-primary rounded-circle d-flex align-items-center justify-content-center fs-4">
                          <i class="ti ti-ticket"></i>
                        </span>
                      </div>
                      <div class="w-100">
                        <h6 class="mb-0 fw-bold fs-3 text-dark">@notif.FullName</h6>
                        <span class="text-muted fs-2 d-block">@notif.City rotası için talep gönderdi.</span>
                        <small class="text-muted fs-1">@notif.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
                      </div>
                    </a>
                }
            }
            else
            {
                <div class="text-center py-4 text-muted">
                  <iconify-icon icon="solar:bell-off-outline" class="fs-7 d-block mb-2 text-muted"></iconify-icon>
                  Yeni bildirim bulunmuyor.
                </div>
            }
          </div>
          <div class="py-2 text-center border-top">
            <a href="/Admin/Booking" class="fs-2 fw-semibold text-primary">Tüm Rezervasyonları Gör</a>
          </div>
        </div>
      </li>
    </ul>
    
    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
      <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
        <li class="nav-item dropdown">
          <a class="nav-link " href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown"
             aria-expanded="false">
            <img src="/Spike-Admin/src/assets/images/profile/user1.jpg" alt="" width="35" height="35"
                 class="rounded-circle">
          </a>
          <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
            <div class="message-body">
              
              <div class="px-4 py-3 border-bottom">
                <h6 class="mb-0 fw-bold">@Model?.FirstName @Model?.LastName</h6>
                <span class="text-muted fs-2">@Model?.Email</span>
              </div>

              <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item mt-2">
                <i class="ti ti-user fs-6"></i>
                <p class="mb-0 fs-3">My Profile</p>
              </a>
              <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                <i class="ti ti-mail fs-6"></i>
                <p class="mb-0 fs-3">My Account</p>
              </a>
              <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item mb-2">
                <i class="ti ti-list-check fs-6"></i>
                <p class="mb-0 fs-3">My Task</p>
              </a>
              
              <a href="/Login/Logout"
                 class="btn btn-outline-primary mx-3 mt-2 d-block">Logout</a>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </nav>
</header>