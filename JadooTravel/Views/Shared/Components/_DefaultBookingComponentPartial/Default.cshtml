@model JadooTravel.ViewModels.DefaultBookingViewModel
@inject JadooTravel.Services.LanguageServices.ILanguageService Lang

@{
    var bgColors = new[] { "bg-primary", "bg-danger", "bg-info", "bg-warning" };
    int colorIndex = 0;
}

<section id="booking">
  <div class="container">
    <div class="row align-items-center">
      
      <div class="col-lg-6">
        <div class="mb-4 text-start">
          <h5 class="text-secondary text-uppercase">@Lang.T("Kolay ve Hızlı")</h5>
          <h3 class="fs-xl-10 fs-lg-8 fs-7 fw-bold font-cursive text-capitalize">@Lang.T("Bir sonraki seyahatinizi 3 kolay adımda planlayın")</h3>
        </div>
        
        @if (Model?.TripPlans != null && Model.TripPlans.Any())
        {
            foreach (var item in Model.TripPlans)
            {
                var currentBg = bgColors[colorIndex % bgColors.Length];
                colorIndex++;

                <div class="d-flex align-items-start mb-5">
                  <div class="@currentBg me-sm-4 me-3 p-3 d-flex align-items-center justify-content-center" style="border-radius: 13px; width: 48px; height: 48px;">
                    @if (!string.IsNullOrEmpty(item.DescriptionIconUrl) && (item.DescriptionIconUrl.StartsWith("http") || item.DescriptionIconUrl.Contains("/")))
                    {
                        <img src="@Url.Content(item.DescriptionIconUrl)" width="22" alt="steps" />
                    }
                    else
                    {
                        <i class="@(string.IsNullOrEmpty(item.DescriptionIconUrl) ? "ti ti-arrow-right" : item.DescriptionIconUrl) text-white fs-5"></i>
                    }
                  </div>
                  <div class="flex-1">
                    <h5 class="text-secondary fw-bold fs-0">@Lang.T(item.Title)</h5>
                    <p class="mb-0 text-muted">@Lang.T(item.Description)</p>
                  </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Lütfen admin panelinden seyahat adımlarını (TripPlan) tanımlayın.</p>
        }
      </div>
      
      <div class="col-lg-6 d-flex justify-content-center align-items-start">
        <div class="card border-0 shadow-lg p-sm-5 p-4 bg-white position-relative" style="border-radius: 26px; max-width: 500px; width: 100%; z-index: 1;">
          
          <div class="position-absolute bg-info opacity-10 rounded-circle d-none d-sm-block" style="width: 60px; height: 60px; top: -30px; right: -30px; z-index: -1;"></div>
          
          <div class="mb-4 text-start">
            <h4 class="fw-bold text-dark mb-2">@Lang.T("Hemen Rezervasyon Yapın")</h4>
            <p class="text-muted fs--1 mb-0">@Lang.T("Hayalinizdeki seyahat için formu doldurun, seyahat uzmanlarımız sizinle anında iletişime geçsin.")</p>
          </div>

          <form action="/Admin/Booking/Create" method="post">
            
            <div class="mb-3">
              <label class="form-label text-secondary fw-bold fs--1 mb-1" for="destination">@Lang.T("Rota Seçin")</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted" style="border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                  <i class="ti ti-map-pin"></i>
                </span>
                <select class="form-select border-start-0 bg-light fs--1" id="destination" name="DestinationId" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;" required>
                  <option value="" disabled selected>@Lang.T("Nereye gitmek istersiniz?")</option>
                  
                  @if (Model?.Destinations != null && Model.Destinations.Any())
                  {
                      foreach (var dest in Model.Destinations)
                      {
                          <option value="@dest.DestinationId">@Lang.T(dest.City), @Lang.T(dest.Country)</option>
                      }
                  }
                </select>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label text-secondary fw-bold fs--1 mb-1" for="fullname">@Lang.T("Adınız Soyadınız")</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted" style="border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                  <i class="ti ti-user"></i>
                </span>
                <input class="form-control border-start-0 bg-light fs--1" type="text" id="fullname" name="FullName" placeholder="@Lang.T("Adınız Soyadınız")" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;" required />
              </div>
            </div>

            
            <div class="row mb-3">
              <div class="col-sm-6 mb-3 mb-sm-0">
                <label class="form-label text-secondary fw-bold fs--1 mb-1" for="phone">@Lang.T("Telefon")</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted" style="border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                    <i class="ti ti-phone"></i>
                  </span>
                  <input class="form-control border-start-0 bg-light fs--1" type="tel" id="phone" name="Phone" placeholder="05xx xxx xx xx" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;" required />
                </div>
              </div>
              <div class="col-sm-6">
                <label class="form-label text-secondary fw-bold fs--1 mb-1" for="email">@Lang.T("E-posta")</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted" style="border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                    <i class="ti ti-mail"></i>
                  </span>
                  <input class="form-control border-start-0 bg-light fs--1" type="email" id="email" name="Email" placeholder="adiniz@posta.com" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;" required />
                </div>
              </div>
            </div>

            
            <div class="row mb-4">
              <div class="col-6">
                <label class="form-label text-secondary fw-bold fs--1 mb-1" for="date">@Lang.T("Gidiş Tarihi")</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted" style="border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                    <i class="ti ti-calendar"></i>
                  </span>
                  <input class="form-control border-start-0 bg-light fs--1" type="date" id="date" name="TravelDate" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;" required />
                </div>
              </div>
              <div class="col-6">
                <label class="form-label text-secondary fw-bold fs--1 mb-1" for="guests">@Lang.T("Kişi Sayısı")</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted" style="border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                    <i class="ti ti-users"></i>
                  </span>
                  <select class="form-select border-start-0 bg-light fs--1" id="guests" name="GuestsCount" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;" required>
                    <option value="1" selected>@Lang.T("1 Kişi")</option>
                    <option value="2">@Lang.T("2 Kişi")</option>
                    <option value="3">@Lang.T("3 Kişi")</option>
                    <option value="4">@Lang.T("4+ Kişi")</option>
                  </select>
                </div>
              </div>
            </div>

            
            <button class="btn btn-warning w-100 py-3 text-white fw-bold d-flex align-items-center justify-content-center gap-2 border-0 shadow" 
                    style="border-radius: 12px; background-color: #DF6951; transition: all 0.3s ease;" 
                    type="submit" 
                    onmouseover="this.style.backgroundColor='#c9563e'" 
                    onmouseout="this.style.backgroundColor='#DF6951'">
              <i class="ti ti-send"></i> @Lang.T("Rezervasyon Talebini Gönder")
            </button>
            
          </form>
        </div>
      </div>
      
    </div>
  </div>
</section>