@model List<ResultDestinationDto>
@inject JadooTravel.Services.LanguageServices.ILanguageService Lang

<section class="pt-5" id="destination">

  <div class="container">
    <div class="position-absolute start-100 bottom-0 translate-middle-x d-none d-xl-block ms-xl-n4">
      <img src="/public/assets/img/dest/shape.svg" alt="destination"/>
    </div>
    
    <div class="mb-7 text-center">
      <h5 class="text-secondary">@Lang.T("En Çok Tercih Edilenler")</h5>
      <h3 class="fs-xl-10 fs-lg-8 fs-7 fw-bold font-cursive text-capitalize">@Lang.T("Tur Rotaları")</h3>
    </div>
    
    <div class="row">
      @if (Model != null)
      {
          foreach (var item in Model)
          {
              <div class="col-md-4 mb-4">
                <div class="card overflow-hidden shadow border-0 rounded-3">
                  <img class="card-img-top" src="@item.ImageUrl" alt="@item.City, @item.Country" style="height: 250px; object-fit: cover;" />
                  <div class="card-body py-4 px-3">
                    <div class="d-flex flex-column flex-lg-row justify-content-between mb-3">
                      <h4 class="text-secondary fw-medium">
                        <a class="link-900 text-decoration-none stretched-link" href="#!">@Lang.T(item.City), @Lang.T(item.Country)</a>
                      </h4>
                      
                      <span class="fs-1 fw-bold text-primary">
                        @if (Lang.CurrentLanguage == "TR")
                        {
                            <span>@item.Price ₺</span>
                        }
                        else if (Lang.CurrentLanguage == "EN")
                        {
                            <span>$@item.Price</span>
                        }
                        else
                        {
                            <span>€@item.Price</span>
                        }
                      </span>
                    </div>
                    
                    <div class="d-flex align-items-center">
                      <img src="/public/assets/img/dest/navigation.svg" style="margin-right: 14px" width="20" alt="navigation"/>
                      <span class="fs-0 fw-medium text-muted">
                        @Lang.T(item.DayNight)
                      </span>
                    </div>
                  </div>
                </div>
              </div>
          }
      }
    </div>
  </div>

</section>